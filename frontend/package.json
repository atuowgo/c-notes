{
  "name": "cnotes-frontend",
  "version": "0.0.1",
  "private": true,
  "description": "知识炼金炉前端 monorepo:多端共享 packages + 各端 apps",
  "scripts": {
    "dev:web": "pnpm --filter @cnotes/web dev",
    "build:web": "pnpm --filter @cnotes/web build",
    "dev:extension": "pnpm --filter @cnotes/extension dev",
    "build:extension": "pnpm --filter @cnotes/extension build",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "typescript": "^5.7.2"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  }
}
