# /root/service/cnotes/.env —— systemd EnvironmentFile,权限须 600,不入库。
# 数据库三项由 install.sh 从 install-db.sh 的产出自动填入(占位符 __DB_*__);其余密钥类需手工填写。

# ---- 数据库(install.sh 自动写入,勿手改;换库/换密码请重跑 install-db.sh 并手工同步) ----
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/__DB_NAME__?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
SPRING_DATASOURCE_USERNAME=__DB_USER__
SPRING_DATASOURCE_PASSWORD=__DB_PASSWORD__

# ---- 模型密钥(必填,自行申请) ----
DEEPSEEK_API_KEY=
LLM_MODEL=deepseek-chat
ARK_API_KEY=
ARK_EMBEDDING_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_EMBEDDING_MODEL=ep-20260617000458-2mslf
ARK_EMBEDDING_DIM=2048

# ---- 鉴权(必填:生成一个 >=32 位随机字符串,如 openssl rand -hex 32) ----
JWT_SECRET=
JWT_EXPIRY=PT1h

# ---- 存储与调度 ----
STORAGE_ROOT=/root/service/cnotes/data
WORKER_SCHEDULING_ENABLED=true
HEADLESS_ENABLED=false

# ---- 日志(Log4j2,按天+100MB 双触发滚动,gzip 压缩历史,保留最近 30 份;ERROR 另落一份独立文件) ----
LOG_PATH=/root/service/cnotes/logs

# ---- 微信(可选,接公众号后填) ----
WECHAT_TOKEN=
